# === API Keys ===
# CWA 中央氣象署 opendata — 申請：https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# 環境部資料開放平台 — 申請：https://data.moenv.gov.tw/
MOENV_API_KEY=

# Google Maps Geocoding API（選用）— Nominatim 找不到時 fallback
# 申請：https://developers.google.com/maps/documentation/geocoding/get-api-key
# 已內建手動座標表處理 6 家 Nominatim 無法解析的醫院，未設此 key 也可達 100% geocoded
GOOGLE_MAPS_KEY=

# === Geocoding（免 key）===
# OSM Nominatim 使用條款要求 User-Agent 含聯絡 email
NOMINATIM_USER_AGENT=LiveSafe.tw/0.1 (contact@example.com)
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search

# === Overpass（免 key，rate limited）===
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
